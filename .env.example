# ControlPlane.ai Gateway Environment Configuration

# Server configurations
CP_SERVER__HOST=0.0.0.0
CP_SERVER__PORT=8080
CP_SERVER__MAX_CONCURRENT_STREAMS=10000
CP_SERVER__TIMEOUT_MS=30000

# Upstream LLM / Gemini API configurations
CP_UPSTREAM__DEFAULT_TARGET_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CP_UPSTREAM__API_KEY=YOUR_GEMINI_API_KEY_HERE
CP_UPSTREAM__MAX_RETRIES=3

# ML Engine configuration paths
CP_ML_ENGINE__ONNX_MODEL_PATH=models/deberta_injection.onnx
CP_ML_ENGINE__SLM_GGUF_PATH=models/llama_validator.gguf
CP_ML_ENGINE__PREFLIGHT_THRESHOLD=0.85
CP_ML_ENGINE__THREAD_POOL_SIZE=4
CP_ML_ENGINE__ENABLE_CUDA=false

# ClickHouse telemetry destination
CP_CLICKHOUSE__URL=http://localhost:8123
CP_CLICKHOUSE__TABLE=audit_logs
CP_CLICKHOUSE__BATCH_SIZE=500
CP_CLICKHOUSE__FLUSH_INTERVAL_MS=1000
